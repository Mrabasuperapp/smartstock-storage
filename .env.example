# App runtime
NODE_ENV=development

# JWT issuer/audience
AUTH_ISSUER=smartstock-storage
AUTH_AUDIENCE=smartstock-storage-api
AUTH_KEY_ID=storage-rs256-v1
AUTH_TOKEN_TTL_SEC=3600

# RSA keypair storage (auto-generated if missing; defaults to <zebra-store>/_meta/keys)
# AUTH_KEY_DIR=
# AUTH_PRIVATE_KEY_PATH=.data/keys/auth-private.pem
# AUTH_PUBLIC_KEY_PATH=.data/keys/auth-public.pem

# Session cookie
AUTH_COOKIE_NAME=storage_access_token
AUTH_COOKIE_SECURE=auto

# REQUIRED at server start: the owners of the console. They sign in with Google (Firebase Authentication)
# and can add or remove other Google accounts in the console (Team). Comma separated.
ADMIN_EMAILS=you@gmail.com
# Optional: use your own Firebase project instead of the shared bfastapp one. Its Authorized domains must include
# the domain you serve this from (Firebase console > Authentication > Settings).
# FIREBASE_WEB_CONFIG={"projectId":"...","apiKey":"...","authDomain":"...","appId":"..."}
# Optional: how long a console sign-in lasts (default 12 hours).
# AUTH_SESSION_TTL_SEC=43200
#
# Service accounts for other servers that exchange a username and password for a token at /storage/auth/token.
# Most services should use a token minted in the console instead, so this can be left out.
# Use passwordHash (sha256 hex, lowercase); generate with:  printf %s 'your-password' | shasum -a 256
# Write tokens minted in the console never expire; revoke them in the console (registry: <zebra-store>/_meta/tokens.json).
# AUTH_USERS_JSON=[{"username":"admin","passwordHash":"6aea6aafc8c446a25beb3c0f9bc56e4d725d5f94cff65138fb8dd0b3c2d2596a","roles":["admin"],"scopes":["storage:read","storage:write","admin:dashboard","admin:files","admin:datastore"]}]

# Storage location: one directory holds the blocks and all state (index log pointer, snapshot, auth keys under _meta/).
# Point it at the persistent volume on the pinned server. Defaults to ~/zebra-store.
# STORAGE_BLOCKSTORE_DIR=/var/lib/smartstock/zebra-store
# STORAGE_NAMESPACE=smartstock-storage

# Access policy (compatibility while clients are migrated to tokens)
# Writes: false = uploads without a valid token are accepted and logged as [zebra:untokened-write];
#         true  = a valid write token is required.
# STORAGE_REQUIRE_WRITE_TOKEN=false
# Largest single upload in MB (default 50).
# STORAGE_MAX_UPLOAD_MB=50
# Reads:  true  = GET /storage/:cid/:name is open (phones follow redirects and cannot send tokens);
#         false = a valid read token is required.
# STORAGE_PUBLIC_READ=true
